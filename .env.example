# ==========================================================
# متغیرهای محیطی — یک کپی از این فایل بساز به اسم .env.local
# و مقادیر واقعی خودت رو (از حساب‌هایی که در گام ۰.۴ ساختی) جایگزین کن.
# .env.local هرگز نباید commit بشه (در .gitignore هست به‌صورت پیش‌فرض).
# ==========================================================

# ---- Neon (PostgreSQL) ----
# از داشبورد Neon → Connection String کپی کن
DATABASE_URL="postgresql://user:password@your-project.region.aws.neon.tech/neondb?sslmode=require"

# ---- Clerk (احراز هویت) ----
# از داشبورد Clerk → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# از داشبورد Clerk → Webhooks → Add Endpoint (بعد از Deploy روی Vercel،
# آدرس https://your-domain.vercel.app/api/webhooks/clerk رو ثبت کن)
CLERK_WEBHOOK_SIGNING_SECRET=""

# ---- Anthropic API (برای پیشنهاد مثال با AI در فرم «افزودن با چند مثال») ----
# از console.anthropic.com بساز. اگه این رو خالی بذاری، بقیه اپ عادی کار می‌کنه،
# فقط دکمه «پیشنهاد از AI» خطا می‌ده.
ANTHROPIC_API_KEY="sk-ant-..."

# ---- فقط برای تست محلی سریع‌تر (طبق DECISIONS.md ورودی ۰۱۴) ----
# با "true" لایه Middleware احراز هویت رو موقتاً غیرفعال می‌کنه (هر Route
# هنوز جدا خودش چک می‌کنه). هیچ‌وقت رو true تو محیط واقعی/Deploy نذار.
DISABLE_AUTH_FOR_TESTING="false"

# ---- برای فازهای بعدی ----
# UNSPLASH_ACCESS_KEY="..."
