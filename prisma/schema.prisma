// ==========================================================
// Prisma Schema — فاز ۱ و ۲ نقشه راه (زیرساخت + هسته لایتنر)
// مدل Note/Card/Template از همان ابتدا، طبق تصمیم DECISIONS.md
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------
// کاربران
// (احراز هویت واقعی توسط Clerk انجام می‌شود؛ این جدول فقط
// داده‌های اپلیکیشنی مرتبط با کاربر را نگه می‌دارد و با
// clerkId به کاربر Clerk وصل می‌شود — با Webhook همگام می‌شود)
// ----------------------------------------------------------
model User {
  id                    String    @id @default(uuid())
  clerkId               String    @unique
  email                 String    @unique
  username              String?   @unique
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  lastActivityDate      DateTime?
  isPremium             Boolean   @default(false)
  preferAdvancedGrading Boolean   @default(false) // حالت ۴ دکمه‌ای Again/Hard/Good/Easy
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  decks      Deck[]
  notes      Note[]
  tags       Tag[]
  reviewLogs ReviewLog[]
  highlights Highlight[]

  @@map("users")
}

// ----------------------------------------------------------
// دسته‌های لایتنر (Deck)
// ----------------------------------------------------------
model Deck {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examContext    String   @default("ielts") // ielts | toefl | gre — آماده گسترش آینده
  name           String
  isDefault      Boolean  @default(false)
  cardCountCache Int      @default(0)
  createdAt      DateTime @default(now())

  cards        Card[]
  boxIntervals LeitnerBoxInterval[]

  @@map("decks")
}

// تنظیمات بازه هر جعبه (روزانه, ۲, ۴, ۸, ۱۶ روز) — قابل شخصی‌سازی به‌ازای هر Deck
model LeitnerBoxInterval {
  id           String @id @default(uuid())
  deckId       String?
  deck         Deck?  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  boxNumber    Int
  intervalDays Int

  @@map("leitner_box_intervals")
}

// ----------------------------------------------------------
// سیستم Note/Card سبک Anki (بخش ۱۲ سند معماری)
// ----------------------------------------------------------

// قالب محتوا — مثلاً "واژه ساده"، "Cloze". برای MVP فقط ۲ مورد Seed می‌شود.
model NoteType {
  id          String   @id @default(uuid())
  name        String
  fieldSchema Json // تعریف فیلدها، نگاه کنید به بخش ۱۲.۲ سند معماری
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  templates CardTemplate[]
  notes     Note[]

  @@map("note_types")
}

// نحوه رندر کارت از روی یک Note (می‌تواند چند Template برای یک NoteType باشد)
model CardTemplate {
  id            String   @id @default(uuid())
  noteTypeId    String
  noteType      NoteType @relation(fields: [noteTypeId], references: [id], onDelete: Cascade)
  name          String
  frontTemplate String
  backTemplate  String
  orderIndex    Int      @default(0)
  isActive      Boolean  @default(true)

  cards Card[]

  @@map("card_templates")
}

// محتوای خام (یک بار ساخته می‌شود، می‌تواند چند Card از رویش بسازد)
model Note {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteTypeId  String
  noteType    NoteType @relation(fields: [noteTypeId], references: [id])
  fieldValues Json // {"front":"aubergine","meaning_fa":"بادمجان","example_en":"..."}
  source      String   @default("manual") // manual | ai_generated | book_import
  createdAt   DateTime @default(now())

  cards Card[]
  tags  NoteTag[]

  @@map("notes")
}

// ----------------------------------------------------------
// تگ‌بندی معنایی — تصمیم ۰۰۱ در DECISIONS.md
// روی سطح Note (نه Card) تا مستقل از جعبه/دسته قابل بازیابی باشد
// ----------------------------------------------------------
model Tag {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  notes NoteTag[]

  @@unique([userId, name])
  @@map("tags")
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}

// ----------------------------------------------------------
// کارت — هر ردیف یک کارت مستقل و قابل‌مرور در جعبه لایتنر
// ----------------------------------------------------------
model Card {
  id             String       @id @default(uuid())
  noteId         String
  note           Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  templateId     String
  template       CardTemplate @relation(fields: [templateId], references: [id])
  deckId         String
  deck           Deck         @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId         String // denormalized برای سرعت کوئری صف مرور
  currentBox     Int          @default(1)
  status         String       @default("active") // active | learned | suspended
  isFlagged      Boolean      @default(false)
  nextReviewAt   DateTime     @default(now())
  lastReviewedAt DateTime?
  correctStreak  Int          @default(0)
  totalReviews   Int          @default(0)
  createdAt      DateTime     @default(now())

  reviewLogs ReviewLog[]

  @@unique([noteId, templateId])
  @@index([userId, nextReviewAt]) // 🔑 مهم‌ترین ایندکس کل پروژه — صف مرور روزانه
  @@map("cards")
}

// تاریخچه هر مرور — منبع آمار آینده + قابلیت Undo
model ReviewLog {
  id           String   @id @default(uuid())
  cardId       String
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade        String // again | hard | good | easy
  simpleResult String // known | unknown  (نگاشت‌شده از grade، برای UI ساده دو دکمه‌ای)
  boxBefore    Int
  boxAfter     Int
  reviewedAt   DateTime @default(now())

  @@index([userId, reviewedAt])
  @@map("review_logs")
}

// ----------------------------------------------------------
// کتابخانه محتوا (ماژول library) — جدا از سیستم Note/Card عمداً، چون
// متن درس (پاراگراف، Language Help) اصلاً شکل فلش‌کارت نداره. Note.userId
// تو این پروژه اجباریه، پس محتوای مشترک (متن درس، لغات رسمی) نمی‌تونه
// از مدل Note استفاده کنه — کاملاً جدا و فقط‌خواندنی برای همه کاربراست.
// Highlight شخصیه و userId داره. طبق DECISIONS.md ورودی ۰۱۲.
// ----------------------------------------------------------

// منبع محتوا — مثلاً کتاب "English Vocabulary in Use"
model Source {
  id            String   @id @default(uuid())
  title         String
  type          String   @default("book") // book | podcast | novel | magazine
  publisher     String?
  level         String?
  coverImageUrl String?
  createdAt     DateTime @default(now())

  lessons Lesson[]

  @@map("sources")
}

// یک درس/Unit از یک منبع
model Lesson {
  id         String  @id @default(uuid())
  sourceId   String
  source     Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  orderIndex Int
  title      String
  unitCode   String?

  // آرایه بلوک‌های محتوا، نه یک HTML خام — تا Highlight (که به blockIndex +
  // آفست کاراکتر درون متن *ساده* همون بلوک اشاره می‌کنه) با هر تغییر جزئی
  // فرمت خراب نشه. نمونه: {"type":"paragraph","text":"..."} یا
  // {"type":"language_help","title":"...","text":"..."}
  contentBlocks Json

  createdAt DateTime @default(now())

  vocabItems LessonVocab[]
  highlights Highlight[]

  @@map("lessons")
}

// لغات رسمی/معرفی‌شده در یک درس — مشترک بین همه، فقط‌خواندنی
model LessonVocab {
  id         String  @id @default(uuid())
  lessonId   String
  lesson     Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  term       String
  meaningFa  String
  exampleEn  String?
  orderIndex Int     @default(0)

  categories LessonVocabCategory[]

  @@map("lesson_vocab")
}

// Highlight/Underline شخصی کاربر روی متن یک درس — سبک، فقط یادآوری بصری
model Highlight {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  blockIndex  Int // اندیس بلوک داخل contentBlocks
  startOffset Int // آفست کاراکتر شروع درون متن ساده همون بلوک
  endOffset   Int
  style       String // color-yellow | color-green | color-blue | color-pink | underline
  createdAt   DateTime @default(now())

  @@index([userId, lessonId])
  @@map("highlights")
}

// دسته‌بندی موضوعی مشترک («گلچین لغات پرکاربرد») — سراسری، جدا از Tag
// شخصی (که userId اجباری داره). طبق تحقیق روی سایت واقعی مرجع.
model Category {
  id   String @id @default(uuid())
  name String
  slug String @unique

  vocabItems LessonVocabCategory[]

  @@map("categories")
}

model LessonVocabCategory {
  lessonVocabId String
  lessonVocab   LessonVocab @relation(fields: [lessonVocabId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([lessonVocabId, categoryId])
  @@map("lesson_vocab_categories")
}
